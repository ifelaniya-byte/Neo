{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "megacompact://schemas/normalized_event_feed.v1.json",
  "title": "MegaCompact Normalized Event Feed v1",
  "description": "Paper-only historical/synth event feed. Each record must carry availability time to enforce time-causality. Never includes private keys or signed live orders.",
  "type": "object",
  "required": ["feed_id", "schema_version", "chain_id", "events"],
  "properties": {
    "feed_id": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "const": "1.0.0" },
    "chain_id": { "type": "integer" },
    "source": { "type": "string" },
    "as_of": { "type": "string", "description": "YYYY-MM-DD or ISO timestamp of feed generation" },
    "license": { "type": "string" },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/NormalizedEvent" }
    }
  },
  "$defs": {
    "NormalizedEvent": {
      "type": "object",
      "required": [
        "event_id",
        "entity_id",
        "event_timestamp_ms",
        "observed_timestamp_ms",
        "available_timestamp_ms",
        "event_type"
      ],
      "properties": {
        "event_id": { "type": "string" },
        "entity_id": { "type": "string" },
        "event_timestamp_ms": { "type": "integer", "minimum": 0 },
        "observed_timestamp_ms": { "type": "integer", "minimum": 0 },
        "available_timestamp_ms": { "type": "integer", "minimum": 0 },
        "event_type": {
          "type": "string",
          "enum": ["swap", "pool_update", "quote", "gas", "block", "oracle", "route", "inclusion", "revert", "bridge", "liquidity", "price"]
        },
        "chain_id": { "type": "integer" },
        "payload": { "type": "object" },
        "checksum": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
